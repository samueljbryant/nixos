// niri config — https://yalter.github.io/niri/Configuration-Introduction.html
// Hot-reloads on save. `Mod` is the Super/Windows key.

// Startup
spawn-at-startup "waybar"
// spawn-at-startup "kanata" // Colemak-DH remap; auto-finds ~/.config/kanata/kanata.kbd
spawn-sh-at-startup "swaybg -m fill -i ~/nixos_dotfiles/config/niri/backgrounds/ito_town.png"

input {
    keyboard {
        xkb {
            layout "us"
            // Carried over from your X11 config: euro on <e>, Caps acts as Esc.
            options "eurosign:e,caps:escape"
        }
        // Ported from autoRepeatDelay=200 / autoRepeatInterval=35ms (~28 Hz).
        repeat-delay 200
        repeat-rate 28
    }

    touchpad {
        tap
        natural-scroll
    }

    // Focus follows the mouse across windows/columns.
    // focus-follows-mouse
}

// --- Monitors (ported from your autorandr profiles) ---
// niri applies these per-output as they connect, so one config covers both
// docked and undocked — no autorandr needed.

output "eDP-1" {
    mode "1920x1200"
    scale 1.0
    // Docked: sits to the right of HDMI-1, dropped 120px (matches autorandr).
    // Undocked, HDMI-1 is absent and niri just uses this at 0,0 automatically.
    // position x=2560 y=120
}

output "HDMI-1" {
    mode "2560x1440"
    scale 1.0
    // position x=0 y=0
}

layout {
    gaps 16
    center-focused-column "never"


    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 1.0; }

    focus-ring {
        // off
        width 2
        active-color "#747c84"
        inactive-color "#1c2023"
    }

    border {
        off
        width 3
        active-gradient from="#f00f" to="#0f05" angle=45 in="oklch longer hue"

    }
}


// Run legacy X11 apps: niri starts xwayland-satellite and sets DISPLAY for us.
xwayland-satellite {
    path "xwayland-satellite"
}

// Don't draw client-side title bars where we can avoid them.
prefer-no-csd


screenshot-path "~/Pictures/Screenshots/Screenshot-%Y%m%d-%H%M%S.png"

binds {
    // Show this list any time:
    // Mod+Shift+Slash { show-hotkey-overlay; }

    // Launchers
    // Mod+Return hotkey-overlay-title="Terminal" { spawn "alacritty"; }
    // Mod+B hotkey-overlay-title="Browser" { spawn "firefox"; }
    // Mod+D      hotkey-overlay-title="App launcher" { spawn "fuzzel"; }

    // Mod+Q { close-window; }

    // Theoretical binds to reduce chording
    Mod+Slash {show-hotkey-overlay;}
    Mod+BackSpace { close-window; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn "alacritty"; }
    Mod+backslash      hotkey-overlay-title="App launcher" { spawn "fuzzel" ; }
    // Mod+backslash      hotkey-overlay-title="App launcher" { spawn "alacritty" "-e" "fsel" "-d"; }
    // Home row, for navigation
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }
    // Home row, for movement
    Mod+U     { move-column-left; }
    Mod+I     { move-column-right; };
    Mod+O     { move-window-up; }
    Mod+P     { move-window-down; }
    // Workspaces, layer above home row, prevent weird stretch
    Mod+7 { focus-workspace 1; }
    Mod+8 { focus-workspace 2; }
    Mod+9 { focus-workspace 3; }
    Mod+0 { focus-workspace 4; }
    // Focus workspaces
    Mod+Minus  { focus-workspace-up; }
    Mod+Equal { focus-workspace-down; }
    // Mod+bracketleft  { focus-workspace-up; }
    // Mod+bracketright  { focus-workspace-down; }
    // Bottom row, window resizing, structural
    Mod+N       { switch-preset-column-width; }
    Mod+M       { maximize-column; }
    Mod+Comma {consume-or-expel-window-left;}
    Mod+Period {consume-or-expel-window-right;}
    // Cross monitor hotkeys
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+H { focus-monitor-left; }
    // TODO: These need to be modified to not start with the Alt key
    Alt+Shift+L { move-column-to-monitor-right; }
    Alt+Shift+H { move-column-to-monitor-left; }

    // Focus (arrows or vim keys)
    // Mod+Left  { focus-column-left; }
    // Mod+Right { focus-column-right; }
    // Mod+Up    { focus-window-up; }
    // Mod+Down  { focus-window-down; }
    // Mod+H     { focus-column-left; }
    // Mod+L     { focus-column-right; }
    // Mod+K     { focus-window-up; }
    // Mod+J     { focus-window-down; }
    //
    // // Move
    // Mod+Shift+Left  { move-column-left; }
    // Mod+Shift+Right { move-column-right; }
    // Mod+Shift+H     { move-column-left; }
    // Mod+Shift+L     { move-column-right; };
    // Mod+Shift+K     { move-window-up; }
    // Mod+Shift+J     { move-window-down; }
    //
    // // Workspaces (niri workspaces are dynamic + per-monitor)
    // Mod+1 { focus-workspace 1; }
    // Mod+2 { focus-workspace 2; }
    // Mod+3 { focus-workspace 3; }
    // Mod+4 { focus-workspace 4; }
    // Mod+U { focus-workspace-down; }
    // Mod+I { focus-workspace-up; }
    //
    // // Column / window sizing
    // Mod+R       { switch-preset-column-width; }
    // Mod+F       { maximize-column; }
    // Mod+Shift+F { fullscreen-window; }
    // // Mod+Comma   { consume-window-into-column; }
    // // Mod+Period  { expel-window-from-column; }
    // Mod+Comma {consume-or-expel-window-left;}
    // Mod+Period {consume-or-expel-window-right;}
    //
    // // Cross Monitor actions
    // Mod+Ctrl+L { focus-monitor-right; }
    // Mod+Ctrl+H { focus-monitor-left; }
    //
    // Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    // Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    //
    // Cross Workspace actions
    Mod+Page_Down { move-window-to-workspace-down; }
    Mod+Page_Up { move-window-to-workspace-up; }

    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+Ctrl+Page_Up { move-workspace-up; }

    // Media / brightness keys (brightnessctl already installed; wpctl ships with pipewire)
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    Mod+Shift+P { screenshot; }

    Mod+Shift+E { quit; }

    // Lock this device 
    Mod+Shift+Ctrl+Delete { spawn "swaylock" "-f"; }
}

// Window Settings
window-rule {
    // geometry-corner-radius 12
    // clip-to-geometry true
}

window-rule {
  match app-id="Alacritty"
  opacity 0.8
}


cursor {
  xcursor-size 12
  hide-when-typing
  hide-after-inactive-ms 1000
}
