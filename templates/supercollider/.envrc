use flake

# Expose the in-development sc_lsp, built imperatively with cargo (not packaged in
# Nix while it's unstable). Defaults to the debug build for fast iteration; the
# release dir is kept on PATH as a fallback for when you haven't built debug.
# Force the release build with:  SC_LSP_PROFILE=release direnv reload
#
# PATH_add prepends, so the profile added LAST wins. Release goes first (fallback),
# then the chosen profile on top. With SC_LSP_PROFILE=release both resolve to
# release, so release always wins regardless of a stale debug build.
sc_lsp_target="$HOME/Development/work/projects/sc_lsp/target"
PATH_add "$sc_lsp_target/release"
PATH_add "$sc_lsp_target/${SC_LSP_PROFILE:-debug}"
